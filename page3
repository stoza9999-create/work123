# services/power.py

def calculate_power(voltage: float, current: float) -> float:
    """
    คำนวณกำลังไฟฟ้า P = V × I

    เงื่อนไข:
    - voltage ต้องมากกว่า 0
    - current ต้องมากกว่าหรือเท่ากับ 0
    - ถ้าผิดเงื่อนไขให้เกิด ValueError
    """
    if voltage <= 0:
        raise ValueError("voltage must be greater than 0")

    if current < 0:
        raise ValueError("current must be greater than or equal to 0")

    return voltage * current


def classify_power(power_watt: float) -> str:
    """
    จำแนกระดับกำลังไฟฟ้า

    < 500 W       -> NORMAL
    500-1000 W    -> WARNING
    > 1000 W      -> CRITICAL
    """
    if power_watt < 500:
        return "NORMAL"
    elif power_watt <= 1000:
        return "WARNING"
    else:
        return "CRITICAL"